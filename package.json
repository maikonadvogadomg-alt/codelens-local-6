{
  "name": "codelens-local",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CodeLens fora da Replit: editor com IA, terminal e preview, rodando no seu PC.",
  "scripts": {
    "iniciar": "node scripts/iniciar.mjs",
    "start": "tsx server/index.ts",
    "build": "vite build",
    "dev": "concurrently -k -n servidor,tela -c blue,magenta \"npm:dev:servidor\" \"npm:dev:tela\"",
    "dev:servidor": "tsx watch --clear-screen=false server/index.ts",
    "dev:tela": "vite",
    "checar": "tsc --noEmit -p tsconfig.json"
  },
