{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": false,
    "skipLibCheck": true,
    "noEmit": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@workspace/db": ["lib/db/index.ts"],
      "@workspace/api-zod": ["lib/api-zod/index.ts"],
      "@workspace/api-client-react": ["lib/api-client-react/index.ts"]
    }
  },
  "include": ["src", "server", "lib", "vite.config.ts", "scripts"]
}
